{
  "name": "snake-ultra-multiplayer",
  "version": "1.0.0",
  "description": "Serveur multijoueur pour Snake Ultra - Deluxe Edition",
  "main": "server.js",
  "scripts": {
  "start": "node server.js",
  "dev": "serve www -l 8080",
  "open": "start http://localhost:8080/index.html",
  "dev:open": "npm run dev && npm run open",
  "multi": "node server.js",
  "multi:full": "concurrently \"npm run dev\" \"npm run multi\" && npm run open",
  "test": "jest --verbose",
  "test:watch": "jest --watch",
  "test:coverage": "jest --coverage",
  "test:unit": "jest tests/unit --verbose",
  "test:integration": "jest tests/integration --verbose"
},
  "keywords": [
    "snake",
    "game",
    "multiplayer",
    "websocket"
  ],
  "author": "Snake Ultra Dev Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "serve": "^14.2.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "jest-environment-node": "^29.7.0"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}