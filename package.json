{
  "name": "snake-ultra-multiplayer",
  "version": "1.0.0",
  "description": "Serveur multijoueur pour Snake Ultra - Deluxe Edition",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "vite",
    "dev:legacy": "serve -l 8081 www",
    "build": "vite build",
    "preview": "vite preview",
    "analyze": "vite build --mode analyze",
    "open": "start http://localhost:8080/index.html",
    "multi": "node server.js",
    "multi:full": "concurrently \"npm run dev\" \"npm run multi\"",
    "test": "jest --verbose",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit --verbose",
    "test:unit-client": "jest --config jest.config.client.js --verbose",
    "test:integration": "jest tests/integration --verbose",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test && npm run test:unit-client && npm run test:e2e",
    "test:report": "playwright show-report",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "cap:build": "npm run build && npx cap sync && npx cap open android"
  },
  "keywords": [
    "snake",
    "game",
    "multiplayer",
    "websocket"
  ],
  "author": "Snake Ultra Dev Team",
  "license": "MIT",
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor-firebase/authentication": "^6.3.1",
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "express": "^4.21.2",
    "firebase": "^12.7.0",
    "serve": "^14.2.5",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@playwright/test": "^1.56.1",
    "@types/jest": "^29.5.11",
    "@vitejs/plugin-legacy": "^7.2.1",
    "autoprefixer": "^10.4.22",
    "cssnano": "^7.1.2",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-environment-node": "^29.7.0",
    "nodemon": "^3.0.1",
    "playwright": "^1.56.1",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "purgecss": "^7.0.2",
    "terser": "^5.44.1",
    "vite": "^7.2.2",
    "vite-plugin-html": "^3.2.2"
  },
  "engines": {
    "node": ">=14.0.0"
  }
}
