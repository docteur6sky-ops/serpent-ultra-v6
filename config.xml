<?xml version='1.0' encoding='utf-8'?>
<widget id="com.cyril.snake" version="1.1.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Snake Mobile</name>
    <description>Un jeu Snake pour mobile</description>
    <author email="votre@email.com" href="http://votresite.com">Cyril</author>
    <content src="index.html" />
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="*" />
    <platform name="android">
        <allow-intent href="market:*" />
        <preference name="AndroidInsecureFileModeEnabled" value="true" />
        <preference name="Scheme" value="http" />
    </platform>
    <preference name="android-minSdkVersion" value="22" />
    <preference name="android-targetSdkVersion" value="35" />
</widget>